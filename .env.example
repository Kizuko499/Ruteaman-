APP_NAME="RuteAman"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ruteaman.my.id
APP_LOCALE=id

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ruteaman
DB_USERNAME=ruteaman_app
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# Email: gunakan log/array hanya untuk lokal & pengujian.
# Production: MAIL_MAILER=smtp, MAIL_HOST=ruteaman.my.id, MAIL_PORT=465,
# MAIL_ENCRYPTION=ssl, MAIL_USERNAME=service@ruteaman.my.id,
# MAIL_PASSWORD=(isi hanya di .env server, jangan commit),
# MAIL_FROM_ADDRESS=service@ruteaman.my.id
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="hello@ruteaman.test"
MAIL_FROM_NAME="${APP_NAME}"

ROUTING_PROVIDER=openrouteservice
ROUTING_BASE_URL=https://api.openrouteservice.org
ROUTING_API_KEY=
ROUTING_PROFILE=foot-walking
ROUTING_TIMEOUT=12
ROUTING_ALTERNATIVES=3
ROUTING_CACHE_SECONDS=60
ROUTE_BUFFER_METERS=25
ROUTE_HAZARD_LIMIT=100
HAZARD_MERGE_DISTANCE_METERS=30
HAZARD_SATURATION=9
BMKG_BASE_URL=

# Direktori nasional sekolah (Dapodik Kemendikdasmen).
# Token boleh dikosongkan; aplikasi akan membaca token publik dari /env.js dan menyimpannya di cache server.
DAPODIK_BASE_URL=https://dapo.kemendikdasmen.go.id
DAPODIK_API_TOKEN=
DAPODIK_TIMEOUT=12
DAPODIK_VERIFY_SSL=false
SCHOOL_DIRECTORY_FALLBACK_URL=https://sekolah.devapi.id
INDONESIA_REGION_API_URL=https://wilayah.id/api

# Account / avatar privacy. PHP GD with WebP required for photo upload.
AVATAR_UPLOAD_REQUIRES_CONSENT=true
ACCOUNT_BLOCKED_NAMES="admin,administrator,moderator,pengguna dihapus,anjing,bangsat,kontol"
# Optional configured contact; no invented school contact.
SCHOOL_HELP_CONTACT=
# Optional school-specific contacts JSON keyed by NPSN or school ID.
SCHOOL_HELP_CONTACTS='{}'

# Public condition publication (set the school slug from your database)
FEATURED_ROTATE_SECONDS=120
DEFAULT_SCHOOL_SLUG=
CONDITION_RESOLVED_HOURS=24
PUBLIC_HAZARD_INDEXABLE=false

# Admin tiers — alias is a login identifier, not a mailbox
ALIAS_EMAIL_DOMAIN=ruteaman.my.id
OWNER_MAX_COUNT=3
INVITE_EXPIRES_HOURS=48
ADMIN_IDLE_MINUTES=20
# Production: APP_DEBUG=false, HTTPS APP_URL, SESSION_SECURE_COOKIE=true, SMTP
